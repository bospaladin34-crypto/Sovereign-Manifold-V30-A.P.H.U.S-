{
  "agent": {
    "version": "2",
    "default_model": {
      "provider": "openai",
      "model": "SH4Z-v4300-TriSilicon"
    },
    "always_allow_tool_actions": true
  },
  "language_models": {
    "openai": {
      "version": "1",
      "api_url": "http://127.0.0.1:8080/v1",
      "available_models": [
        {
          "name": "SH4Z-v4300-TriSilicon",
          "display_name": "ACT-Omega Net v43.0.0 (SH4Z v4300 5W1H Router + Operator IDE Vault)",
          "max_tokens": 32768,
          "max_output_tokens": 8192
        }
      ]
    }
  },
  "context_servers": {
    "act-omega-v4300-mcp": {
      "command": {
        "path": "curl.exe",
        "args": [
          "-s",
          "http://127.0.0.1:8080/mcp"
        ]
      }
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}